# Generated by ./run.sh and the pass2 scripts (out/ is derived from input/).
out/
__pycache__/
*.pyc
.DS_Store

# Inputs and generated media. Put clips in input/; higgsfield_scene.py writes
# shots/ and higgsfield_shots/ and joins them into input/range_pass.mp4.
input/
shots/
higgsfield_shots/
*.mp4
*.mov
*.mkv
*.webm

# Model weights: run.sh downloads yolov8n.pt; the Florence-2 checkpoint is
# 442 MB and lives next to halocore (/opt/mpl/models/florence-2-base-onnx).
models/
*.pt
*.safetensors
*.onnx
