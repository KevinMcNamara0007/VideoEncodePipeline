# Generated by ./run.sh (out/ is derived from input/).
out/
build/
compile_commands.json
.cache/
__pycache__/
*.pyc
.DS_Store

# Inputs and generated media. Put clips in input/; previews land in output/.
input/
*.mp4
*.mov
*.mkv
*.webm

# Model weights: run.sh downloads the .pt checkpoints and exports each head to
# .onnx (+ .names.json) once with tools/export_onnx.py; the Florence-2 checkpoint is
# 442 MB and lives next to halocore (/opt/mpl/models/florence-2-base-onnx).
models/
*.pt
*.safetensors
*.onnx
